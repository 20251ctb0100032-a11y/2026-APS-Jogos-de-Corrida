        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml banco-de-dados-velocitygames\n\ntitle Diagrama do Banco de Dados - VelocityGames\n\nhide circle\nskinparam linetype ortho\nskinparam entity {\n    BackgroundColor #EAF2F8\n    BorderColor #2874A6\n    FontColor #17202A\n}\n\nentity \&quot;jogo\&quot; as jogo {\n    * id : INT &lt;&lt;PK&gt;&gt;\n    --\n    titulo : VARCHAR(100)\n    plataforma : VARCHAR(50)\n    ano_lancamento : INT\n}\n\nentity \&quot;exemplar\&quot; as exemplar {\n    * id : INT &lt;&lt;PK&gt;&gt;\n    --\n    jogo_id : INT &lt;&lt;FK&gt;&gt;\n    status : VARCHAR(20)\n}\n\nentity \&quot;cliente\&quot; as cliente {\n    * id : INT &lt;&lt;PK&gt;&gt;\n    --\n    nome : VARCHAR(100)\n    telefone : VARCHAR(20)\n}\n\nentity \&quot;administrador\&quot; as administrador {\n    * id : INT &lt;&lt;PK&gt;&gt;\n    --\n    nome : VARCHAR(100)\n}\n\nentity \&quot;emprestimo\&quot; as emprestimo {\n    * id : INT &lt;&lt;PK&gt;&gt;\n    --\n    cliente_id : INT &lt;&lt;FK&gt;&gt;\n    exemplar_id : INT &lt;&lt;FK&gt;&gt;\n    administrador_id : INT &lt;&lt;FK&gt;&gt;\n    data_retirada : DATE\n    data_prevista : DATE\n    data_devolucao : DATE\n}\n\njogo ||--|{ exemplar : possui\n\ncliente ||--o{ emprestimo : realiza\n\nadministrador ||--o{ emprestimo : registra\n\nexemplar ||--o{ emprestimo : participa\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="K_Ebd-VmdN_oADfkQLtD-1">
